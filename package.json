{
  "name": "dispatchai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Recruiter-focused, production-style agentic field-service dispatch platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@dispatchai/web",
    "dev:agent": "node --env-file=.env ./node_modules/vite-node/dist/cli.mjs packages/agent/src/bin/agent-server.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "react": "18.3.1"
  }
}
