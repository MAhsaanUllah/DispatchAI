      "parameters": {
        "jsCode": "const headers = $input.item.json.headers || {};\nconst authSecret = headers['x-dispatch-secret'] || (headers['authorization'] || '').replace(/^Bearer\\s+/, '');\nconst expectedSecret = $env.N8N_WEBHOOK_SECRET || 'dev_secret_dispatch_2026';\nconst correlationId = headers['x-correlation-id'] || `corr_${Date.now()}`;\n\nif (authSecret !== expectedSecret) {\n  return [{\n    json: {\n      authenticated: false,\n      error: {\n        code: 'UNAUTHORIZED',\n        message: 'Invalid or missing x-dispatch-secret authentication header',\n        retryable: false\n      },\n      correlationId\n    }\n  }];\n}\n\nconst body = $input.item.json.body || {};\nconst requiredFields = ['idempotencyKey', 'customerId', 'propertyId', 'serviceType', 'issueSummary', 'urgency', 'slotId', 'createdBy'];\n\nfor (const field of requiredFields) {\n  if (!body[field]) {\n    return [{\n      json: {\n        authenticated: true,\n        valid: false,\n        error: {\n          code: 'INVALID_INPUT',\n          message: `Field \"${field}\" is required`,\n          retryable: false\n        },\n        correlationId\n      }\n    }];\n  }\n}\n\nreturn [{\n  json: {\n    authenticated: true,\n    valid: true,\n    payload: body,\n    correlationId\n  }\n}];"
      },
