{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DispatchAI",
  "version": "0.1.0",
  "identifier": "dev.dispatchai.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "main", "title": "DispatchAI", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../build/node.exe": "node.exe",
      "../build/agent-server.js": "agent-server.js",
      "../build/web": "web"
    }
  }
}
