{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dispatchai-agent",
  "workers_dev": false,
  "main": "packages/agent/src/cloudflare.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DispatchCloudAgent", "class_name": "DispatchCloudAgent" }]
  },
  "vpc_services": [{ "binding": "N8N", "service_id": "01a0ce78-235e-7040-9dfd-ab3a3ed28b11", "remote": true }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatchCloudAgent"] }]
}
