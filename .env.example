# DispatchAI Environment Variables Template
# Copy this file to .env and fill in the values for local development.
# NEVER commit real secrets or .env files to source control.

NODE_ENV=development
PORT=3100

# Structured Database Configuration
DATABASE_URL=file:./data/dispatchai.sqlite

# n8n Operational Workflow Integration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
DATABASE_SERVICE_URL=http://localhost:3100

# Cloudflare Agents SDK Runtime
CLOUDFLARE_AGENT_ENDPOINT=http://localhost:8788
AGENT_AUTH_TOKEN=your_agent_internal_token_here

# ElevenLabs Conversational Voice Interface
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret_here

# Web Dashboard (Frontend)
VITE_AGENT_API_URL=http://localhost:8787
VITE_WS_URL=ws://localhost:8787/ws
WEB_ORIGIN=http://localhost:5173
