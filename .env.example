# DispatchAI settings. Copy to .env. Everything here is optional: the dashboard asks for the rest.
# NEVER commit real secrets or .env files.

# --- First start ---
# One-time code for the first-run setup page. Leave empty to get a random code in `docker compose logs app`.
SETUP_TOKEN=
# Encrypts plugin keys. Leave empty to create data/master.key automatically; on a VPS set a long random value.
MASTER_KEY=
# Starting template before onboarding: field-service | salon | auto-repair | home-cleaning
BUSINESS_TEMPLATE=field-service
# true = fictional demo customers, staff and slots. Leave false for a real business.
SEED_DEMO_DATA=false

# --- Docker (docker-compose.yml) ---
# Local port for the dashboard (default 8080).
APP_PORT=8080
# Address people and Twilio use to reach the dashboard, e.g. https://bookings.yourdomain.com
PUBLIC_URL=
# VPS profile: the domain Caddy gets an HTTPS certificate for (DNS must point to this server).
PUBLIC_DOMAIN=
# Tunnel profile: Cloudflare Tunnel token (route its public hostname to http://app:8080).
TUNNEL_TOKEN=

# --- Scripted installs only (the Plugins page is the normal way to set these) ---
RESEND_API_KEY=
EMAIL_FROM=
N8N_EVENTS_URL=
N8N_EVENTS_SECRET=

# --- Local development without Docker (npm run dev:agent + npm run dev) ---
# DATABASE_URL=./data/dispatchai.sqlite
# AGENT_PORT=8787
# WEB_ORIGIN=http://localhost:5173

# Set to true when you use the vps or tunnel profile, so rate limits apply per visitor and not to the proxy.
TRUST_PROXY=
